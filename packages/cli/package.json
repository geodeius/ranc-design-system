{
  "name": "@rancard/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "lint": "eslint src",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@rancard/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "rancard": {
    "owners": [
      "design-systems"
    ],
    "status": "planned"
  }
}
