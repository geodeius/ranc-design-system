{
  "name": "@rancard/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate:ai && next build",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>{rmSync('.next',{recursive:true,force:true});rmSync('dist',{recursive:true,force:true})})\"",
    "dev": "next dev",
    "generate:ai": "node --import tsx scripts/generate-ai-context.ts",
    "lint": "eslint app components lib scripts tests next.config.ts",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:accessibility": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:ai": "node --import tsx scripts/generate-ai-context.ts --check",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "validate:links": "node --import tsx scripts/validate-links.ts",
    "validate:registries": "node --import tsx scripts/validate-registries.ts"
  },
  "dependencies": {
    "@rancard/documentation-schema": "workspace:*",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "next": "16.2.12",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@rancard/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "catalog:"
  },
  "rancard": {
    "owners": [
      "design-systems"
    ],
    "status": "planned"
  }
}
