{
  "name": "rancard-design-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "accessibility:check": "pnpm --filter @rancard/docs test:accessibility",
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=HEAD",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "node --test tests/*.test.mjs && turbo run test",
    "typecheck": "turbo run typecheck",
    "validate:content": "turbo run validate:content",
    "validate:registries": "turbo run validate:registries",
    "validate:workspace": "node scripts/validate-workspace.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@rancard/eslint-config": "workspace:*",
    "@rancard/typescript-config": "workspace:*",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
